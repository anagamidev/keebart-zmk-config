#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&kp TAB              &kp Q             &kp W                 &kp E             &kp R              &kp T      &lt 5 TAB  &none      &kp Y         &kp U               &kp I                 &kp O                 &kp P                &kp BSPC
&mt LCTRL BACKSPACE  &hml RIGHT_GUI A  &hml RIGHT_CONTROL S  &hml LEFT_ALT D   &hml LEFT_SHIFT F  &kp G      &kp LALT   &kp ENTER  &kp H         &hmr RIGHT_SHIFT J  &hmr LEFT_ALT K       &hmr RIGHT_CONTROL L  &hmr RIGHT_GUI SEMI  &kp SQT
&kp LSHFT            &kp Z             &kp X                 &hml RIGHT_ALT C  &kp V              &kp B                            &kp N         &kp M               &hmr RIGHT_ALT COMMA  &kp DOT               &kp FSLH             &kp ESC
                                                             &lt 3 ESCAPE      &lt 1 BACKSPACE    &kp SPACE                        &lt 4 DELETE  &lt 2 SPACE         &lt 6 BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        symbol_layer {
            display-name = "EXTRA 1";
            bindings = <
&trans  &kp GRAVE                &kp AT_SIGN            &kp PLUS             &kp LEFT_BRACE                   &kp HASH   &trans  &trans  &kp ASTERISK       &kp RIGHT_BRACE                    &kp MINUS                &kp PERCENT       &trans     &trans
&trans  &hm LEFT_GUI UNDERSCORE  &hm LEFT_CONTROL PIPE  &hm LEFT_ALT EQUAL   &hm LEFT_SHIFT LEFT_PARENTHESIS  &kp CARET  &trans  &trans  &kp DOLLAR         &hm RIGHT_SHIFT RIGHT_PARENTHESIS  &kp UNDER                &kp AMPERSAND     &kp COLON  &trans
&trans  &kp BACKSLASH            &kp EXCLAMATION        &hm RIGHT_ALT TILDE  &kp LEFT_BRACKET                 &kp SQT                    &kp DOUBLE_QUOTES  &kp RIGHT_BRACKET                  &hm RIGHT_ALT LESS_THAN  &kp GREATER_THAN  &kp SLASH  &trans
                                                        &trans               &trans                           &trans                     &trans             &trans                             &trans
            >;
        };

        number_layer {
            display-name = "EXTRA 2";
            bindings = <
&trans  &kp F1           &kp F2               &kp F3             &kp F4             &trans  &trans  &trans  &trans        &kp N7                    &kp N8                  &kp N9                      &trans  &trans
&trans  &hm LEFT_GUI F5  &hm LEFT_CONTROL F6  &hm LEFT_ALT F7    &hm LEFT_SHIFT F8  &trans  &trans  &trans  &trans        &hm RIGHT_SHIFT NUMBER_4  &hm LEFT_ALT N5         &hm RIGHT_CONTROL NUMBER_6  &trans  &trans
&trans  &kp F9           &kp F10              &hm RIGHT_ALT F11  &kp F12            &trans                  &kp NUMBER_0  &kp NUMBER_1              &hm RIGHT_ALT NUMBER_2  &kp NUMBER_3                &trans  &trans
                                              &trans             &trans             &trans                  &trans        &trans                    &trans
            >;
        };

        arrows_layer {
            display-name = "EXTRA 3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &trans    &trans        &trans     &trans  &trans
                        &trans  &trans  &trans                  &trans    &trans    &trans
            >;
        };

        others_layer {
            display-name = "EXTRA 4";
            bindings = <
&trans  &trans  &trans      &trans   &kp PRINTSCREEN  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp INSERT  &kp DEL  &kp PAGE_UP      &kp PAGE_DOWN  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans   &kp HOME         &kp END                        &trans  &trans  &trans  &trans  &trans  &trans
                            &trans   &trans           &trans                         &trans  &trans  &trans
            >;
        };

        keyboard_layer {
            display-name = "EXTRA 5";
            bindings = <
&bl BL_TOG       &bl BL_INC  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &trans  &trans  &trans  &trans        &trans        &out OUT_TOG  &ext_power EP_TOG  &trans
&rgb_ug RGB_TOG  &bl BL_DEC  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &trans  &trans  &trans  &bt BT_SEL 3  &bt BT_SEL 4  &trans        &trans             &trans
&rgb_ug RGB_EFF  &trans      &trans           &sys_reset       &bootloader      &studio_unlock                   &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR         &trans
                                              &trans           &trans           &trans                           &trans  &trans        &trans
            >;
        };

        extra_layer_6 {
            display-name = "EXTRA 6";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };
    };
};
